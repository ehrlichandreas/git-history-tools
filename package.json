{
  "name": "git-history-tools",
  "private": true,
  "version": "0.3.1",
  "description": "Three tools for preparing a git history for publication: git-release-squash, git-leak-scan, git-history-rewrite.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "git-release-squash": "bin/git-release-squash",
    "git-leak-scan": "bin/git-leak-scan",
    "git-history-rewrite": "bin/git-history-rewrite"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/run-all.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
