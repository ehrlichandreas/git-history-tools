{
  "name": "git-history-tools",
  "private": true,
  "version": "0.3.1",
  "description": "Three tools for preparing a git history for publication: git-release-squash, git-leak-scan, git-history-rewrite.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "git-release-squash": "dist/squash.mjs",
    "git-leak-scan": "dist/scan.mjs",
    "git-history-rewrite": "dist/rewrite.mjs"
  },
  "scripts": {
    "build": "node tools/bundle.ts",
    "build:check": "node tools/bundle.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-all.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  }
}
